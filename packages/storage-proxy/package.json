{
  "dependencies": {
    "aws4fetch": "1.0.20",
    "hono": "4.13.19",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "wrangler": "4.163.0"
  },
  "name": "@repo/storage-proxy",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
