{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "npm",
    "mise",
    "github-actions",
    "cargo",
    "dockerfile",
    "custom.jsonata"
  ],
  "extends": [
    "config:recommended",
    "helpers:disableTypesNodeMajor",
    "customManagers:biomeVersions"
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "groupName": "node types",
      "matchPackageNames": ["@types/node"]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@types/react-is"
      ]
    },
    {
      "groupName": "storybook",
      "matchPackageNames": ["storybook", "@storybook/*"]
    },
    {
      "groupName": "radix ui",
      "matchPackageNames": ["radix-ui", "@radix-ui/*"]
    },
    {
      "groupName": "tailwindcss",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/*"]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "@vitest/*"]
    },
    {
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler", "@cloudflare/*"]
    },
    { "groupName": "node", "matchDepNames": ["node"] },
    { "groupName": "pnpm", "matchDepNames": ["pnpm"] }
  ],
  "prConcurrentLimit": 30,
  "prHourlyLimit": 0,
  "reviewers": ["sendo-kakeru"],
  "schedule": ["* * * * 5"],
  "timezone": "Asia/Tokyo"
}
