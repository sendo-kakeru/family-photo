{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "enabled": true,
    "rules": {
      "complexity": {
        "useOptionalChain": "error"
      },
      "correctness": {
        "noConstantCondition": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useUniqueElementIds": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noReturnInFinally": "error",
        "useAwaitThenable": "error",
        "useNullishCoalescing": "error",
        "usePromiseRejectErrors": "error",
        "useTailwindShorthandClasses": "warn",
        "useTailwindSortedClasses": "warn"
      },
      "preset": "recommended",
      "style": {
        "noInferrableTypes": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "error",
        "noUnknownAtRules": "off"
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "tailwind": {
    "attributes": ["class", "className", "classList"],
    "mergeFunctions": ["cn", "cva"],
    "stylesheet": "./packages/app/src/app/globals.css"
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
