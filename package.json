{
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "lefthook": "2.1.12",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.21.0"
  },
  "name": "family-photo",
  "packageManager": "pnpm@12.4.1",
