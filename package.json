{
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.22.1"
  },
  "name": "family-photo",
  "packageManager": "pnpm@12.15.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "ci": "biome ci && turbo run typecheck",
